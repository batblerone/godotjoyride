[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://scripts/target/debug/libscripts.so"
linux.release.x86_64 =   "res://scripts/target/release/libscripts.so"
windows.debug.x86_64 =   "res://scripts/target/debug/scripts.dll"
windows.release.x86_64 = "res://scripts/target/x86_64-pc-windows-gnullvm/release/scripts.dll"
macos.debug =            "res://scripts/target/debug/libscripts.dylib"
macos.release =          "res://scripts/target/release/libscripts.dylib"
macos.debug.arm64 =      "res://scripts/target/debug/libscripts.dylib"
macos.release.arm64 =    "res://scripts/target/release/libscripts.dylib"
